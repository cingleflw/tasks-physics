{
    "id": "7_mechanics",
    "grade": 7,
    "title": "Механическое движение",
    "tasks": [
        {
            "id": 1,
            "text": "Велосипедист ехал {t} мин со скоростью {v} км/ч. Какое расстояние он проехал?",
            "params": {
                "t": { "choices": [15, 30, 45, 90] },
                "v": { "min": 12, "max": 24, "step": 4 }
            },
            "answer": "v * t / 60",
            "unit": "км"
        },
        {
            "id": 2,
            "text": "Автомобиль движется со скоростью {v} км/ч. Какой путь он пройдёт за {t} ч?",
            "params": {
                "v": { "min": 40, "max": 90, "step": 5 },
                "t": { "min": 1, "max": 4 }
            },
            "answer": "v * t",
            "unit": "км"
        },
        {
            "id": 3,
            "text": "Поезд, двигаясь равномерно, прошёл {s} км за {t} ч. Найдите скорость поезда.",
            "params": {
                "v": { "min": 40, "max": 120, "step": 10 },
                "t": { "min": 2, "max": 6 }
            },
            "derived": {
                "s": "v * t"
            },
            "answer": "v",
            "unit": "км/ч"
        },
        {
            "id": 4,
            "text": "Сколько времени понадобится пешеходу, чтобы пройти {s} км со скоростью {v} км/ч?",
            "params": {
                "v": { "min": 3, "max": 6 },
                "t": { "min": 1, "max": 4 }
            },
            "derived": {
                "s": "v * t"
            },
            "answer": "t",
            "unit": "ч"
        },
        {
            "id": 5,
            "text": "Автобус ехал {t1} ч со скоростью {v1} км/ч, а затем ещё {t2} ч со скоростью {v2} км/ч. Найдите среднюю скорость автобуса на всём пути. Ответ округлите до десятых.",
            "params": {
                "t1": { "min": 1, "max": 3 },
                "v1": { "min": 40, "max": 60, "step": 5 },
                "t2": { "min": 1, "max": 3 },
                "v2": { "min": 65, "max": 90, "step": 5 }
            },
            "answer": "(v1 * t1 + v2 * t2) / (t1 + t2)",
            "unit": "км/ч",
            "precision": 1
        },
        {
            "id": 6,
            "text": "Мальчик бежит со скоростью {v} м/с. Какой путь он пробежит за {t} мин?",
            "params": {
                "v": { "min": 2, "max": 5 },
                "t": { "min": 1, "max": 5 }
            },
            "answer": "v * t * 60",
            "unit": "м"
        }
    ]
}
