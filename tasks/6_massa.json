{
    "id": "6_massa",
    "grade": 6,
    "title": "Масса и плотность",
    "tasks": [
        {
            "id": 1,
            "text": "Найдите массу тела объёмом {V} см³, если его плотность {ro} г/см³.",
            "params": {
                "ro": { "min": 1, "max": 10 },
                "V": { "min": 1, "max": 10 }
            },
            "answer": "ro * V",
            "unit": "г"
        },
        {
            "id": 2,
            "text": "Брусок объёмом {V} см³ имеет массу {m} г. Определите плотность вещества, из которого он сделан.",
            "params": {
                "ro": { "choices": [2.7, 7.8, 8.5, 8.9, 11.3] },
                "V": { "min": 10, "max": 50, "step": 5 }
            },
            "derived": {
                "m": "ro * V"
            },
            "answer": "ro",
            "unit": "г/см³",
            "precision": 1
        },
        {
            "id": 3,
            "text": "Деталь из {material.name} имеет массу {m} г. Плотность {material.name} равна {material.ro} г/см³. Найдите объём детали.",
            "params": {
                "material": { "choices": [
                    { "name": "алюминия", "ro": 2.7 },
                    { "name": "стали", "ro": 7.8 },
                    { "name": "меди", "ro": 8.9 },
                    { "name": "свинца", "ro": 11.3 }
                ] },
                "V": { "min": 5, "max": 50, "step": 5 }
            },
            "derived": {
                "m": "material.ro * V"
            },
            "answer": "V",
            "unit": "см³"
        },
        {
            "id": 4,
            "text": "Какова масса {liquid.name} объёмом {V} л? Плотность {liquid.name} равна {liquid.ro} кг/м³, 1 л = 0,001 м³.",
            "params": {
                "liquid": { "choices": [
                    { "name": "воды", "ro": 1000 },
                    { "name": "керосина", "ro": 800 },
                    { "name": "бензина", "ro": 710 },
                    { "name": "подсолнечного масла", "ro": 930 },
                    { "name": "молока", "ro": 1030 }
                ] },
                "V": { "min": 2, "max": 20 }
            },
            "answer": "liquid.ro * V / 1000",
            "unit": "кг"
        },
        {
            "id": 5,
            "text": "Брусок из {material.name} имеет размеры {a} см × {b} см × {c} см. Найдите его массу, если плотность {material.name} равна {material.ro} г/см³.",
            "params": {
                "material": { "choices": [
                    { "name": "алюминия", "ro": 2.7 },
                    { "name": "железа", "ro": 7.8 },
                    { "name": "сухой сосны", "ro": 0.4 },
                    { "name": "сухого дуба", "ro": 0.7 }
                ] },
                "a": { "min": 2, "max": 10 },
                "b": { "min": 2, "max": 6 },
                "c": { "min": 1, "max": 5 }
            },
            "answer": "material.ro * a * b * c",
            "unit": "г",
            "precision": 1
        },
        {
            "id": 6,
            "text": "Камень массой {m} г опустили в мензурку с водой, и уровень воды поднялся с {v1} мл до {v2} мл. Определите плотность камня.",
            "params": {
                "ro": { "choices": [2.2, 2.5, 2.6, 2.7, 3] },
                "V": { "min": 10, "max": 40, "step": 5 },
                "v1": { "min": 50, "max": 100, "step": 10 }
            },
            "derived": {
                "v2": "v1 + V",
                "m": "ro * V"
            },
            "answer": "ro",
            "unit": "г/см³",
            "precision": 1
        }
    ]
}
