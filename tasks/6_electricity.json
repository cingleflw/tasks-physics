                "q1": { "min": 2, "max": 20, "step": 2 },
                "q2": { "min": -20, "max": -2, "step": 2 }
            },
            "answer": "(q1 + q2) / 2",
            "unit": "нКл"
        },
        {
            "id": 2,
            "text": "Две капли воды с зарядами {q1} нКл и {q2} нКл слились в одну. Каков заряд получившейся капли?",
            "params": {
                "q1": { "min": 1, "max": 15 },
                "q2": { "min": -10, "max": -1 }
