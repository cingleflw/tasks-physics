{
    "id": "8_electric_current",
    "grade": 8,
    "title": "Работа и мощность электрического тока",
    "tasks": [
        {
            "id": 1,
            "text": "Какова мощность электрической лампы, если при напряжении {U} В сила тока в ней {I} А?",
            "params": {
                "U": { "choices": [12, 220] },
                "I": { "min": 0.1, "max": 1, "step": 0.1 }
            },
            "answer": "U * I",
            "unit": "Вт",
            "precision": 1
        },
        {
            "id": 2,
            "text": "Какую работу совершает электрический ток в электродвигателе за {t} мин, если напряжение на двигателе {U} В, а сила тока {I} А?",
            "params": {
                "U": { "choices": [12, 24, 220] },
                "I": { "min": 1, "max": 5 },
                "t": { "min": 1, "max": 10 }
            },
            "answer": "U * I * t * 60 / 1000",
            "unit": "кДж"
        },
        {
            "id": 3,
            "text": "Электрический чайник мощностью {P} Вт включён в сеть напряжением 220 В. Какова сила тока в нагревательном элементе чайника?",
            "params": {
                "I": { "min": 5, "max": 10, "step": 0.5 }
            },
            "derived": {
                "P": "220 * I"
            },
            "answer": "I",
            "unit": "А",
            "precision": 1
        },
        {
            "id": 4,
            "text": "Телевизор мощностью {P} Вт работает {h} ч в сутки. Сколько стоит электроэнергия, израсходованная им за 30 дней, если 1 кВт·ч стоит {price} руб.?",
            "params": {
                "P": { "choices": [60, 100, 150, 200] },
                "h": { "min": 2, "max": 8 },
                "price": { "min": 4, "max": 8, "step": 0.5 }
            },
            "answer": "P / 1000 * h * 30 * price",
            "unit": "руб."
        },
        {
            "id": 5,
            "text": "Какое количество теплоты выделит за {t} мин спираль электроплитки сопротивлением {R} Ом при силе тока {I} А?",
            "params": {
                "I": { "min": 3, "max": 5 },
                "R": { "min": 25, "max": 45, "step": 5 },
                "t": { "min": 1, "max": 10 }
            },
            "answer": "I * I * R * t * 60 / 1000",
            "unit": "кДж",
            "precision": 1
        },
        {
            "id": 6,
            "text": "Какова мощность электроприбора сопротивлением {R} Ом, включённого в сеть напряжением 220 В?",
            "params": {
                "R": { "choices": [22, 40, 44, 55, 88, 110, 121, 242, 484] }
            },
            "answer": "220 * 220 / R",
            "unit": "Вт"
        }
    ]
